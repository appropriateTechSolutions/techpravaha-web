# Copy to .dev.vars for `wrangler dev`. Dummy values only; real secrets via `wrangler secret put`.
RAZORPAY_KEY_ID=rzp_test_dummy
RAZORPAY_KEY_SECRET=dummy_key_secret
RAZORPAY_WEBHOOK_SECRET=dummy_webhook_secret
RESEND_API_KEY=re_dummy
SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/DUMMY/exec
SHEETS_WEBHOOK_TOKEN=dummy_sheets_token
# Anthropic key for the chat (POST /chat) and the lab proxy (POST /lab/complete). Unset, /chat answers 502 with
# the outage reply and /lab/complete answers 503 so the lab apps show their offline state:
ANTHROPIC_API_KEY=sk-ant-dummy
# Lab model (default claude-haiku-5-5). Claude 4.x ids (claude-haiku-4-5, claude-sonnet-4-6) get the per-app
# temperature; any newer id gets thinking off and no sampling params, since those models reject a temperature.
# LAB_MODEL=claude-haiku-5-5
# Optional chat model (default claude-haiku-5-5). The chat request sends thinking disabled at effort low and no
# sampling params; check another model accepts that before setting it:
# CHAT_MODEL=claude-haiku-5-5
# Order/lead pings to Telegram (both needed; otherwise order pings email ALERT_EMAIL and lead pings are skipped):
# TELEGRAM_BOT_TOKEN=123456:dummy_bot_token
# TELEGRAM_CHAT_ID=123456789
# Optional receipt-email vars (normally set in wrangler.toml [vars]):
# BOOKING_URL=https://calendar.app.google/REPLACE
# WHATSAPP_NUMBER=91XXXXXXXXXX
# For the browser e2e (E2E_RAZORPAY=1) the site is served from :4173, so allow that origin:
# ALLOWED_ORIGINS=http://localhost:4173,http://localhost:3000
